rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(userId);
    }

    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(sessionId);
    }

    match /weeks/{weekId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(weekId);
    }

    match /picks/{pickDocId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(pickDocId);
    }

    match /system/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
